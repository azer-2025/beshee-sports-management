<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bishe.system.mapper.sports.SpEquipmentCategoryMapper">

    <resultMap id="SpEquipmentCategoryResult" type="com.bishe.system.domain.sports.SpEquipmentCategory">
        <result property="categoryId" column="category_id" />
        <result property="categoryName" column="category_name" />
        <result property="classType" column="class_type" />
        <result property="categoryCode" column="category_code" />
        <result property="orderNum" column="order_num" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCategoryVo">
        select category_id, category_name, class_type, category_code, order_num, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from sp_equipment_category
    </sql>

    <select id="selectCategoryById" parameterType="Long" resultMap="SpEquipmentCategoryResult">
        <include refid="selectCategoryVo"/>
        where category_id = #{categoryId} and del_flag = '0'
    </select>

    <select id="selectCategoryList" parameterType="com.bishe.system.domain.sports.SpEquipmentCategory" resultMap="SpEquipmentCategoryResult">
        <include refid="selectCategoryVo"/>
        <where>
            del_flag = '0'
            <if test="categoryName != null and categoryName != ''">
                and category_name like concat('%', #{categoryName}, '%')
            </if>
            <if test="classType != null and classType != ''">
                and class_type = #{classType}
            </if>
            <if test="categoryCode != null and categoryCode != ''">
                and category_code like concat('%', #{categoryCode}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by order_num asc, category_id desc
    </select>

    <select id="selectEnabledCategories" resultMap="SpEquipmentCategoryResult">
        <include refid="selectCategoryVo"/>
        where del_flag = '0' and status = '0'
        order by order_num asc, category_id asc
    </select>

    <insert id="insertCategory" parameterType="com.bishe.system.domain.sports.SpEquipmentCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into sp_equipment_category (
            category_name, class_type, category_code, order_num, status, remark, create_by, create_time
        ) values (
            #{categoryName}, #{classType}, #{categoryCode}, #{orderNum}, #{status}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateCategory" parameterType="com.bishe.system.domain.sports.SpEquipmentCategory">
        update sp_equipment_category
        <set>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="classType != null and classType != ''">class_type = #{classType},</if>
            <if test="categoryCode != null and categoryCode != ''">category_code = #{categoryCode},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId} and del_flag = '0'
    </update>

    <update id="deleteCategoryByIds" parameterType="Long">
        update sp_equipment_category
        set del_flag = '2', update_time = sysdate()
        where category_id in
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

</mapper>
